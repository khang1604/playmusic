# ==========================================
# PLAYMUSIC - ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================
# Notice: Copy this file to .env for local overrides. Never commit actual secret keys.

# Application Environment (development | staging | production)
VITE_APP_ENV=development

# Application Title & Identifier
VITE_APP_NAME="PlayMusic Studio"
VITE_APP_VERSION="1.0.0"

# Audio Engine Defaults
VITE_DEFAULT_SAMPLE_RATE=48000
VITE_MAX_SLOTS=30
VITE_DEFAULT_FADE_DURATION_MS=500
VITE_PANIC_HOTKEY="Space"

# Native Desktop Port (Tauri dev bridge)
PORT=5173
TAURI_DEV_HOST=localhost
